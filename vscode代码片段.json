{
  "AutoCommission: 地图追踪": {
    "prefix": "ac-地图追踪-map",
    "body": [
      "{",
      "  \"type\": \"地图追踪\",",
      "  \"data\": \"${1:路径文件.json}\",",
      "  \"note\": \"${2:导航到目标位置}\"",
      "},"
    ],
    "description": "地图追踪 — 执行路径追踪文件（相对当前流程目录）"
  },

  "AutoCommission: 对话 (空)": {
    "prefix": "ac-对话-empty",
    "body": [
      "{",
      "  \"type\": \"对话\",",
      "  \"note\": \"${1:与NPC对话}\"",
      "},"
    ],
    "description": "对话 — 不带配置，自动选择最后一项并跳过剧情"
  },

  "AutoCommission: 对话 (优先选项+白名单)": {
    "prefix": "ac-对话-talk",
    "body": [
      "{",
      "  \"type\": \"对话\",",
      "  \"data\": {",
      "    \"priorityOptions\": [\"${1:优先选项}\"],",
      "    \"npcWhiteList\": [\"${2:NPC白名单}\"]",
      "  },",
      "  \"note\": \"${3:与NPC对话}\"",
      "},"
    ],
    "description": "对话 — 指定优先对话选项和 NPC 白名单"
  },

  "AutoCommission: 等待返回主界面": {
    "prefix": "ac-等待返回主界面-mainUI",
    "body": [
      "{",
      "  \"type\": \"等待返回主界面\",",
      "  \"note\": \"${1:等待返回主界面}\"",
      "},"
    ],
    "description": "等待返回主界面 — 默认最长 120s、每秒检查一次"
  },

  "AutoCommission: 等待返回主界面 (自定义超时)": {
    "prefix": "ac-等待返回主界面-超时-mainUI-timeout",
    "body": [
      "{",
      "  \"type\": \"等待返回主界面\",",
      "  \"data\": {",
      "    \"maxWaitTime\": ${1:120000},",
      "    \"checkInterval\": ${2:1000}",
      "  },",
      "  \"note\": \"${3:等待返回主界面}\"",
      "},"
    ],
    "description": "等待返回主界面 — 自定义最长等待时间和检查间隔（毫秒）"
  },

  "AutoCommission: 追踪委托 (NPC 名)": {
    "prefix": "ac-追踪委托-name",
    "body": [
      "{",
      "  \"type\": \"追踪委托\",",
      "  \"data\": \"${1:NPC名}\",",
      "  \"note\": \"${2:导航到NPC}\"",
      "},"
    ],
    "description": "追踪委托 — 字符串形式只传 NPC 名（图标类型默认 bigmap）"
  },

  "AutoCommission: 追踪委托 (Bigmap)": {
    "prefix": "ac-追踪委托-bigmap",
    "body": [
      "{",
      "  \"type\": \"追踪委托\",",
      "  \"data\": {",
      "    \"npc\": \"${1:NPC名}\",",
      "    \"iconType\": \"bigmap\"",
      "  },",
      "  \"note\": \"${2:导航到NPC}\"",
      "},"
    ],
    "description": "追踪委托 — Bigmap 图标（大地图常规委托图标）"
  },

  "AutoCommission: 追踪委托 (Question)": {
    "prefix": "ac-追踪委托-question",
    "body": [
      "{",
      "  \"type\": \"追踪委托\",",
      "  \"data\": {",
      "    \"npc\": \"${1:NPC名}\",",
      "    \"iconType\": \"question\"",
      "  },",
      "  \"note\": \"${2:导航到NPC}\"",
      "},"
    ],
    "description": "追踪委托 — Question 图标（问号委托）"
  },

  "AutoCommission: 追踪委托 (Task)": {
    "prefix": "ac-追踪委托-task",
    "body": [
      "{",
      "  \"type\": \"追踪委托\",",
      "  \"data\": {",
      "    \"npc\": \"${1:NPC名}\",",
      "    \"iconType\": \"task\"",
      "  },",
      "  \"note\": \"${2:导航到NPC}\"",
      "},"
    ],
    "description": "追踪委托 — Task 图标（感叹号任务）"
  },

  "AutoCommission: 追踪委托 (到达后自动对话)": {
    "prefix": "ac-追踪委托-autoTalk",
    "body": [
      "{",
      "  \"type\": \"追踪委托\",",
      "  \"data\": {",
      "    \"npc\": \"${1:NPC名}\",",
      "    \"iconType\": \"${2|bigmap,question,task|}\",",
      "    \"autoTalk\": true",
      "  },",
      "  \"note\": \"${3:到达NPC并自动按F对话}\"",
      "},"
    ],
    "description": "追踪委托 — 到达后自动按 F 触发对话"
  },

  "AutoCommission: 传送 (tp)": {
    "prefix": "ac-tp-传送",
    "body": [
      "{",
      "  \"type\": \"tp\",",
      "  \"data\": {",
      "    \"x\": ${1:0},",
      "    \"y\": ${2:0}",
      "  },",
      "  \"note\": \"${3:传送到目标坐标}\"",
      "},"
    ],
    "description": "传送 — 传送到指定坐标（自动选择最近锚点）"
  },

  "AutoCommission: 传送 (强制 tp)": {
    "prefix": "ac-tp-force",
    "body": [
      "{",
      "  \"type\": \"tp\",",
      "  \"data\": {",
      "    \"x\": ${1:0},",
      "    \"y\": ${2:0},",
      "    \"force\": true",
      "  },",
      "  \"note\": \"${3:强制传送}\"",
      "},"
    ],
    "description": "传送 — 强制传送（force=true，跳过锚点选择逻辑）"
  },

  "AutoCommission: 等待": {
    "prefix": "ac-等待-wait",
    "body": [
      "{",
      "  \"type\": \"等待\",",
      "  \"data\": ${1:1000},",
      "  \"note\": \"${2:等待 N 毫秒}\"",
      "},"
    ],
    "description": "等待 — 等待指定毫秒数"
  },

  "AutoCommission: 按键 (press)": {
    "prefix": "ac-按键-press",
    "body": [
      "{",
      "  \"type\": \"按键\",",
      "  \"data\": \"${1:F}\",",
      "  \"note\": \"${2:按下并释放}\"",
      "},"
    ],
    "description": "按键 — 单击按下并释放（如 F / VK_SPACE）"
  },

  "AutoCommission: 按键 (down)": {
    "prefix": "ac-按键-down",
    "body": [
      "{",
      "  \"type\": \"按键\",",
      "  \"data\": {",
      "    \"key\": \"${1:VK_W}\",",
      "    \"action\": \"down\"",
      "  },",
      "  \"note\": \"${2:按下不放}\"",
      "},"
    ],
    "description": "按键 — 按下不释放（与 up 配对使用）"
  },

  "AutoCommission: 按键 (up)": {
    "prefix": "ac-按键-up",
    "body": [
      "{",
      "  \"type\": \"按键\",",
      "  \"data\": {",
      "    \"key\": \"${1:VK_W}\",",
      "    \"action\": \"up\"",
      "  },",
      "  \"note\": \"${2:释放按键}\"",
      "},"
    ],
    "description": "按键 — 释放按键（与 down 配对使用）"
  },

  "AutoCommission: 键鼠脚本": {
    "prefix": "ac-键鼠脚本-keymouse",
    "body": [
      "{",
      "  \"type\": \"键鼠脚本\",",
      "  \"data\": \"${1:脚本文件.json}\",",
      "  \"note\": \"${2:执行键鼠宏脚本}\"",
      "},"
    ],
    "description": "键鼠脚本 — 执行键鼠宏脚本文件（相对当前流程目录）"
  },

  "AutoCommission: 自动剧情 - 启用 (AutoSkip)": {
    "prefix": "ac-自动剧情-启用-AutoSkip",
    "body": [
      "{",
      "  \"type\": \"自动任务\",",
      "  \"data\": {",
      "    \"action\": \"enable\",",
      "    \"taskType\": \"AutoSkip\"",
      "  },",
      "  \"note\": \"${1:启用自动剧情}\"",
      "},"
    ],
    "description": "自动任务 — 启用自动跳剧情（AutoSkip）"
  },

  "AutoCommission: 自动拾取 - 启用 (AutoPick)": {
    "prefix": "ac-自动拾取-启用-AutoPick",
    "body": [
      "{",
      "  \"type\": \"自动任务\",",
      "  \"data\": {",
      "    \"action\": \"enable\",",
      "    \"taskType\": \"AutoPick\"",
      "  },",
      "  \"note\": \"${1:启用自动拾取}\"",
      "},"
    ],
    "description": "自动任务 — 启用自动拾取（AutoPick）"
  },

  "AutoCommission: 自动拾取 - 启用 急速 (AutoPick + forceInteraction)": {
    "prefix": "ac-自动拾取-启用-急速-AutoPick-force",
    "body": [
      "{",
      "  \"type\": \"自动任务\",",
      "  \"data\": {",
      "    \"action\": \"enable\",",
      "    \"taskType\": \"AutoPick\",",
      "    \"config\": {",
      "      \"forceInteraction\": true",
      "    }",
      "  },",
      "  \"note\": \"${1:启用急速自动拾取}\"",
      "},"
    ],
    "description": "自动任务 — 启用自动拾取并打开 forceInteraction（急速）"
  },

  "AutoCommission: 自动任务 - 禁用全部 (disable)": {
    "prefix": "ac-自动任务-禁用全部-disable",
    "body": [
      "{",
      "  \"type\": \"自动任务\",",
      "  \"data\": {",
      "    \"action\": \"disable\"",
      "  },",
      "  \"note\": \"${1:取消所有实时自动任务}\"",
      "},"
    ],
    "description": "自动任务 — disable 会清空所有实时任务（不分 taskType）"
  },

  "AutoCommission: 定时自动战斗": {
    "prefix": "ac-定时自动战斗-autofight",
    "body": [
      "{",
      "  \"type\": \"定时自动战斗\",",
      "  \"data\": {",
      "    \"timeout\": ${1:30000},",
      "    \"intervals\": ${2:5000}",
      "  },",
      "  \"note\": \"${3:启动自动战斗并定时检测结束}\"",
      "},"
    ],
    "description": "定时自动战斗 — 启用 AutoFight，按 intervals 检测战斗是否结束，timeout 后强制收兵"
  },

  "AutoCommission: 切换队伍 - 战斗": {
    "prefix": "ac-切换队伍-战斗-team-battle",
    "body": [
      "{",
      "  \"type\": \"切换队伍\",",
      "  \"data\": \"战斗\",",
      "  \"note\": \"${1:切换到设置中的战斗队伍}\"",
      "},"
    ],
    "description": "切换队伍 — 切换到 settings.team 配置的战斗队伍"
  },

  "AutoCommission: 切换队伍 - 元素采集": {
    "prefix": "ac-切换队伍-元素采集-team-element",
    "body": [
      "{",
      "  \"type\": \"切换队伍\",",
      "  \"data\": \"元素采集\",",
      "  \"note\": \"${1:切换到设置中的元素采集队伍}\"",
      "},"
    ],
    "description": "切换队伍 — 切换到 settings.elementTeam 配置的元素采集队伍"
  },

  "AutoCommission: 切换队伍 - 自定义": {
    "prefix": "ac-切换队伍-自定义-team-custom",
    "body": [
      "{",
      "  \"type\": \"切换队伍\",",
      "  \"data\": \"${1:队伍名称}\",",
      "  \"note\": \"${2:切换到指定名称的队伍}\"",
      "},"
    ],
    "description": "切换队伍 — 自定义队伍名（游戏内队伍配置里的原名）"
  },

  "AutoCommission: 切换角色 (4 槽位)": {
    "prefix": "ac-切换角色-switch-role",
    "body": [
      "{",
      "  \"type\": \"切换角色\",",
      "  \"data\": {",
      "    \"1\": \"${1:角色1}\",",
      "    \"2\": \"${2:角色2}\",",
      "    \"3\": \"${3:角色3}\",",
      "    \"4\": \"${4:角色4}\"",
      "  },",
      "  \"note\": \"${5:一次切换 4 个槽位的角色}\"",
      "},"
    ],
    "description": "切换角色 — 在队伍配置界面一次切换 1-4 个槽位（键为 \"1\"-\"4\"）"
  },

  "AutoCommission: 地址检测": {
    "prefix": "ac-地址检测-location",
    "body": [
      "{",
      "  \"type\": \"地址检测\",",
      "  \"data\": {",
      "    \"x\": ${1:0},",
      "    \"y\": ${2:0},",
      "    \"tolerance\": ${3:15}",
      "  },",
      "  \"run\": \"${4:命中后追加的子流程.json}\",",
      "  \"note\": \"${5:按坐标距离选择分支}\"",
      "},"
    ],
    "description": "地址检测 — 委托坐标在 tolerance 内时插入 run 指定的子流程"
  },

  "AutoCommission: 委托描述检测 (字符串)": {
    "prefix": "ac-委托描述检测-commission-desc",
    "body": [
      "{",
      "  \"type\": \"委托描述检测\",",
      "  \"data\": \"${1:期望的委托描述}\",",
      "  \"run\": \"${2:命中后追加的子流程.json}\",",
      "  \"note\": \"${3:按描述选择分支}\"",
      "},"
    ],
    "description": "委托描述检测 — 整段描述编辑距离匹配，命中后插入 run 指定的子流程"
  },

  "AutoCommission: 委托描述检测 (关键字)": {
    "prefix": "ac-委托描述检测-关键字-keyword",
    "body": [
      "{",
      "  \"type\": \"委托描述检测\",",
      "  \"data\": {",
      "    \"keyword\": \"${1:关键字}\",",
      "    \"useKeyword\": true,",
      "    \"executeFile\": \"${2:命中后追加的文件.json}\",",
      "    \"runType\": \"${3|process,path|}\"",
      "  },",
      "  \"note\": \"${4:用关键字子串匹配描述}\"",
      "},"
    ],
    "description": "委托描述检测 — 关键字子串匹配，runType=process 插入流程 / path 直接跑路径文件"
  },

  "AutoCommission: 用户分支选择": {
    "prefix": "ac-用户分支选择-user-branch",
    "body": [
      "{",
      "  \"type\": \"用户分支选择\",",
      "  \"default\": \"${1:branch-1}\",",
      "  \"data\": {",
      "    \"branch-1\": {",
      "      \"type\": \"${2:地图追踪}\",",
      "      \"data\": \"${3:分支1.json}\",",
      "      \"note\": \"${4:分支1}\"",
      "    },",
      "    \"branch-2\": {",
      "      \"type\": \"${5:地图追踪}\",",
      "      \"data\": \"${6:分支2.json}\",",
      "      \"note\": \"${7:分支2}\"",
      "    }",
      "  },",
      "  \"note\": \"${8:根据用户配置选择分支}\"",
      "},"
    ],
    "description": "用户分支选择 — 按 config/commission-branches.json 决定执行哪个分支（selected 优先，全完成回落 default）"
  },

  "AutoCommission: 流程分支 (include 子流程)": {
    "prefix": "ac-流程分支-flow-branch-include",
    "body": [
      "{",
      "  \"type\": \"流程分支\",",
      "  \"data\": {",
      "    \"path\": \"${1:子流程文件.json}\"",
      "  },",
      "  \"note\": \"${2:无条件加载并执行子流程}\"",
      "},"
    ],
    "description": "流程分支 — 加载子流程文件并 splice 到当前 step 之后（无前置条件）"
  }
}
